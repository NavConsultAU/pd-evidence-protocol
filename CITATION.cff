message: If you use this protocol, please cite it as below.
type: dataset
title: Evidence grading protocol for Parkinson's questions
authors:
  - family-names: Smith
    given-names: Ryan
    affiliation: Navigator Consulting
version: 0.2.1
date-released: "2026-08-17"
license: CC-BY-4.0
